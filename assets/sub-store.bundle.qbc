      PRAGMA journal_mode = WAL;
      PRAGMA synchronous = NORMAL;
      PRAGMA temp_store = memory;
      PRAGMA optimize;

      CREATE TABLE IF NOT EXISTS cacheInterceptorV¢	 (
        -- Data specific to us
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        url TEXT NOT NULL,
        method TEXT NOT NULL,

        -- Data returned to the interceptor
        body BUF NULL,
        compressed TEXT NULL,
        deleteAt INTEGER NOT NULL,
        statusCode INTEGER NOT NULL,
        statusMessage TEXT NOT NULL,
        headers TEXT NULL,
        cacheControlDirectives TEXT NULL,
        etag TEXT NULL,
        vary TEXT NULL,
        cachedAt INTEGER NOT NULL,
        staleAt INTEGER NOT NULL
      );

      CREATE INDEX IF NOT EXISTS idx_cacheInterceptorVH_getValuesQuery ON cacheInterceptorVž(url, method, deleteAt);
      CREATE INDEX IF NOT EXISTS idx_cacheInterceptorVL_deleteByUrlQuery ON cacheInterceptorV (deleteAt);
    prepareˆ
      SELECT
        id,
        body,
        compressed,
        deleteAt,
        statusCode,
        statusMessage,
        headers,
        etag,
        cacheControlDirectives,
        vary,
        cachedAt,
        staleAt
      FROM cacheInterceptorV¸
      WHERE
        url = ?
        AND method = ?
      ORDER BY
        deleteAt ASC
    >
      UPDATE cacheInterceptorV¼ SET
        body = ?,
        compressed = ?,
        deleteAt = ?,
        statusCode = ?,
        statusMessage = ?,
        headers = ?,
        etag = ?,
        cacheControlDirectives = ?,
        vary = ?,
        cachedAt = ?,
        staleAt = ?
      WHERE
        id = ?
    H
      INSERT INTO cacheInterceptorVÒ (
        url,
        method,
        body,
        compressed,
        deleteAt,
        statusCode,
        statusMessage,
        headers,
        etag,
        cacheControlDirectives,
        vary,
        cachedAt,
        staleAt
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    :DELETE FROM cacheInterceptorV WHERE url = ?^SELECT COUNT(*) AS total FROM cacheInterceptorV( WHERE deleteAt <= ?L
        DELETE FROM cacheInterceptorV®
        WHERE id IN (
          SELECT
            id
          FROM cacheInterceptorV†
          ORDER BY cachedAt ASC
          LIMIT ?
        )
